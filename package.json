{
	"name": "corpse-club",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev --test-scheduled",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"gen": "wrangler types",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:migrate:local": "wrangler d1 migrations apply corpse-club --local",
		"db:migrate:remote": "wrangler d1 migrations apply corpse-club --remote",
		"deploy": "npm run build && wrangler deploy",
		"vapid": "node scripts/generate-vapid.mjs",
		"icons": "node scripts/generate-icons.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.3",
		"http_ece": "^1.2.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.3",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource/pirata-one": "^5.3.0"
	}
}
